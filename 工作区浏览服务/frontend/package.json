{
  "name": "nora-workspace-browser",
  "version": "0.8.87",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check:shared": "node scripts/check-shared-components.mjs && node scripts/check-shared-layout.mjs",
    "check:shared-layout": "node scripts/check-shared-layout.mjs",
    "test:shared-layout": "node scripts/check-shared-layout.mjs --self-test",
    "test:shared-check": "node --test scripts/shared-component-rules.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.62.1",
    "postcss": "8.5.28",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
